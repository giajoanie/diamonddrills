# Copy to .env and fill in real values. Never commit .env.

# Postgres connection (matches docker-compose.yml defaults for local dev)
DATABASE_URL="postgresql://deca_hub:deca_hub_dev@localhost:5432/deca_hub"

# Local dev file storage (Phase 3+). Points to a folder under the repo root.
# Used only when BLOB_READ_WRITE_TOKEN isn't set — see File storage in
# DEPLOYMENT.md for why production (Vercel) needs Blob instead.
FILE_STORAGE_DIR="./.data/uploads"

# Vercel Blob token (production file storage). Leave unset for local dev.
# Auto-populated by Vercel when a Blob store is created and connected to
# the project — you don't need to copy this by hand.
# BLOB_READ_WRITE_TOKEN=

# Node environment
NODE_ENV="development"
